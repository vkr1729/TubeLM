# .env.example — copy to .env and fill in your values
# Do NOT commit .env to version control.
#
# First-time setup: run `.venv/bin/notebooklm login --browser-cookies chrome`
# to extract cookies from Chrome. Requires `rookiepy` (included in requirements.txt).

# ── SMTP Settings (required) ─────────────────────────────────────────────────
# Gmail example: smtp.gmail.com / 587 (STARTTLS) or 465 (SSL)
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password-here

# ── Email Addresses (required) ───────────────────────────────────────────────
SENDER_EMAIL=you@gmail.com
RECIPIENT_EMAIL=you@gmail.com

# ── YouTube Data API (REQUIRED) ──────────────────────────────────────────────
# Used for duration-based Shorts filtering (videos < 3 minutes are excluded).
# Get a free key at: https://console.cloud.google.com → APIs → YouTube Data API v3
# Daily quota (10,000 units) is more than enough for weekly processing.
YOUTUBE_API_KEY=your-api-key-here

# ── NotebookLM Browser Settings (optional, defaults shown) ───────────────────
# Which browser's cookies database to extract cookies from.
# Options: chrome, firefox, opera, edge, chromium, vivaldi, safari (macOS only)
NOTEBOOKLM_BROWSER=chrome

# Infographics remain available but are disabled to save NotebookLM compute.
GENERATE_INFOGRAPHICS=false

# NotebookLM audio overview / podcast generation (disabled by default to save compute)
GENERATE_PODCASTS=false

# Optional cross-source email selected by agy with Gemini 3.8 Flash (High).
# Requires the `agy` CLI to be installed and authenticated.
GENERATE_TOP_10_DIGEST=false

# ── Top 10 Video Downloader Settings (optional, defaults shown) ───────────────
# Download the ranked weekly Top 10 YouTube videos locally using yt-dlp.
DOWNLOAD_TOP_10_VIDEOS=false
TOP10_DOWNLOAD_DIR=~/Downloads/Top_10
TOP10_PREV_DIR=~/Downloads/Top_10_Prev

# ── Audio Web Compression (optional, default: true) ─────────────────────────
# 64k mono MP3 transcoding minimizes mobile data and keeps gh-pages deploys small.
COMPRESS_AUDIO=true

# ── Cinematic Video for Top Digest Articles (optional, default: false) ────────
# Strictly opt-in. When false, RSS/web articles are never queued for video generation.
GENERATE_TOP_ARTICLE_VIDEOS=false

# ── Summary TTS Narration (Edge-TTS, free) ────────────────────────────────────
# High-signal, natural voice for spoken summaries in Web Reader Mini-Player.
# Options: en-US-BrianMultilingualNeural, en-US-AndrewMultilingualNeural,
#          en-US-AvaMultilingualNeural, en-GB-RyanNeural
TTS_VOICE=en-US-BrianMultilingualNeural
TTS_RATE=+0%

# ── Cloudflare R2 Audio Hosting (required for audio URLs, optional fallback) ──
# Audio overviews are hosted on R2 so gh-pages stays under 1 MB.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

